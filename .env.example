# Runtime and build mode
NODE_ENV=development
NEXT_PHASE=

# AI assistant (a real Anthropic key must be supplied; blank uses offline fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ASSISTANT_MODEL=claude-opus-4-8

# Invitation and demo seeding
INVITE_TTL=72h
DEMO_OWNER_EMAIL=owner@demo.launchpad.local
DEMO_OWNER_PASSWORD=LaunchPadDemo!2026

# API
HTTP_ADDR=:8080
APP_ENV=local
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3013

# MongoDB
MONGODB_URI=mongodb://launchpad:launchpad@localhost:27017/launchpad?authSource=admin
MONGODB_DATABASE=launchpad

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (required; change in every non-local environment)
JWT_SECRET=local-dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
PASSWORD_MIN_LENGTH=10

# Tenant-secret encryption at rest (optional; recommended outside local).
# Encrypts HRIS API tokens, SSO client secrets, and Slack/Teams webhook URLs
# stored in MongoDB. Unset = plaintext storage (one startup warning is logged).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Platform bootstrap (optional; creates platform_owner on startup)
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=

# Transactional email (optional; unset = log-only sender, no delivery).
# Resend-compatible HTTP API: POST {EMAIL_BASE_URL}/emails with a bearer key.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_BASE_URL=https://api.resend.com
# Provider-agnostic SMS JSON gateway (optional). The gateway receives
# {"to","from","message"} with SMS_API_KEY as a bearer token.
SMS_API_KEY=
SMS_FROM=LaunchPad
SMS_BASE_URL=

# Optional authenticated JSON collectors for server errors and W3C server
# spans. Leave unset to retain local structured logging only.
ERROR_TRACKING_URL=
TRACING_EXPORT_URL=
OBSERVABILITY_TOKEN=
# Base URL of the org-admin portal, used to build invitation/reset links.
ORG_ADMIN_URL=http://localhost:3002
API_PUBLIC_URL=http://localhost:8080

# Calendar OAuth app registrations (optional). Register this callback URL with
# both providers: ${API_PUBLIC_URL}/api/v1/calendar/oauth/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common

# SAML service-provider signing key pair in PEM form. Keep the private key
# secret and stable; publish each tenant's metadata URL to its identity provider.
SAML_SP_PRIVATE_KEY=
SAML_SP_CERTIFICATE=

# Background scheduler tick for due-soon/overdue notification sweeps.
SCHEDULER_INTERVAL=15m

# Payments (optional; unset = invoices still generate, hosted checkout and the
# Paystack webhook degrade to "not configured"). Use sandbox keys locally.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ORG_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
